<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the unchanged production operations into a separate process. -->
    <Compile Include="../QuietSnip/CaptureService.cs" Link="Production/CaptureService.cs" />
    <Compile Include="../QuietSnip/AppSettings.cs" Link="Production/AppSettings.cs" />
  </ItemGroup>
</Project>
