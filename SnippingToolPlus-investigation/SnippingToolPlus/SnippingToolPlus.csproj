<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.4.3</Version>
    <Description>Lightweight region capture for Windows.</Description>
    <AssemblyName>Snipping Tool+</AssemblyName>
    <RootNamespace>SnippingToolPlus</RootNamespace>
    <Product>Snipping Tool+</Product>
    <AssemblyTitle>Snipping Tool+</AssemblyTitle>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="SnippingToolPlus.app.ico" />
    <InternalsVisibleTo Include="SnippingToolPlus.Tests" />
  </ItemGroup>
</Project>
